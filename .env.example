# Application (copy to .env: make env)
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# Docker Compose publish ports (host side)
API_PUBLISH_PORT=8000
DASHBOARD_PUBLISH_PORT=8501
POSTGRES_PUBLISH_PORT=5432
DEFAULT_STORE_ID=store-001

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=
CORS_ORIGINS=http://localhost:8501,http://localhost:3000

# Health checks (app/health.py)
HEALTH_STALE_FEED_MINUTES_WARN=15
HEALTH_STALE_FEED_MINUTES_CRITICAL=60
HEALTH_INGESTION_LAG_WARN_SECONDS=120
HEALTH_INGESTION_LAG_CRITICAL_SECONDS=600

# Anomaly detection (app/anomalies.py)
ANOMALY_BASELINE_WINDOW_HOURS=168
ANOMALY_CURRENT_WINDOW_MINUTES=60
ANOMALY_Z_SCORE_WARN=2.0
ANOMALY_Z_SCORE_CRITICAL=3.0
ANOMALY_CONVERSION_DROP_WARN_PCT=25
ANOMALY_CONVERSION_DROP_CRITICAL_PCT=50
ANOMALY_QUEUE_SPIKE_ABSOLUTE_CRITICAL=15
ANOMALY_STALE_FEED_MINUTES_WARN=15
ANOMALY_STALE_FEED_MINUTES_CRITICAL=60

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=store_intel
POSTGRES_PASSWORD=store_intel_dev
POSTGRES_DB=store_intel
DATABASE_URL=postgresql+asyncpg://store_intel:store_intel_dev@postgres:5432/store_intel

# Pipeline — detection (python -m pipeline.detect --source ...)
VIDEO_SOURCE=
MODEL_PATH=
MODELS_CONFIG_PATH=configs/models.yaml
DETECTION_CONFIDENCE=
DETECTION_IOU=
DETECTION_DEVICE=cpu
DETECTION_FPS_LIMIT=
DETECTION_OUTPUT_DIR=data/events/detections
DETECTION_VISUALIZE=false
DETECTION_SAVE_ANNOTATED=false
MAX_CONSECUTIVE_DROP_FRAMES=30

# Tracking (python -m pipeline.tracker --source ...)
DETECTION_TRACK_TIMEOUT_FRAMES=
DETECTION_TRACK_HISTORY_MAX_POINTS=500
DETECTION_TRAJECTORY_LENGTH=30
DETECTION_GROUP_ENTRY_MIN_SIZE=2

# Visitor sessions (pipeline/session.py)
SESSION_TIMEOUT_SECONDS=300
SESSION_MAX_COMPLETED=10000
SESSION_MAX_TRACK_MAPPINGS=5000

# Lightweight Re-ID (pipeline/reid.py) — see pipeline/REID.md
REID_ENABLED=true
REID_SIMILARITY_THRESHOLD=0.72
REID_REENTRY_TIMEOUT_SECONDS=300
REID_GALLERY_MAX=500

# Event emission (pipeline/emit.py)
EMIT_EVENTS_OUTPUT_DIR=data/events
EMIT_INGEST_BATCH_SIZE=50
EMIT_FSYNC_ON_FLUSH=false

# Pipeline — full runner (legacy)
PIPELINE_VIDEO_SOURCE=/data/sample/demo.mp4
PIPELINE_STORE_ID=store-001
PIPELINE_CAMERA_ID=cam-entrance
PIPELINE_FPS_LIMIT=10
ENABLE_REID=false
ENABLE_GPU=false
STORE_LAYOUT_PATH=/app/configs/store_layout.yaml
MODELS_CONFIG_PATH=/app/configs/models.yaml
EVENTS_OUTPUT_DIR=/data/events

# Ingest
INGEST_API_URL=http://api:8000
INGEST_BATCH_SIZE=50
INGEST_FLUSH_SECONDS=1.0
INGEST_MAX_RETRIES=3

# Dashboard
DASHBOARD_API_URL=http://api:8000
DASHBOARD_REFRESH_SECONDS=2

# Feature flags (graceful degradation)
DEGRADE_REID=false
DEGRADE_STAFF_CLASSIFIER=false
